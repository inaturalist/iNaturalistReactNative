# Copy to fastlane/.env (gitignored). Used by Fastlane only — not bundled into the app.
# Do not put these keys in the repo-root .env or .env.staging (react-native-config reads those).
GITHUB_TOKEN="github api token"
IOS_PROVISIONING_PROFILE_NAME="provisioning profile name"
IOS_SHARE_BUNDLE_ID="share bundle ID"
IOS_SHARE_PROVISIONING_PROFILE_NAME="share provisioning profile name"
SLACK_URL="Slack webhook URL"
