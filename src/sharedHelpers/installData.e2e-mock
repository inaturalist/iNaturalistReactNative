import { useCallback, useEffect, useState } from "react";
import * as uuid from "uuid";

const INSTALL_ID = "installID";
const ONBOARDING_SHOWN = "onboardingShown";
const ONBOARDING_V2_SHOWN = "onboardingV2Shown";
export const IS_FRESH_INSTALL = "isFreshInstall";
const ENVIRONMENT_OVERRIDE = "environmentOverride";

const data = new Map();

export const store = {
  getString: ( key ) => data.get( key ),
  set: ( key, value ) => { data.set( key, value ); },
  getBoolean: ( key ) => data.get( key ),
  delete: ( key ) => { data.delete( key ); },
  contains: ( key ) => data.has( key )
};

export function getInstallID( ) {
  const id = store.getString( INSTALL_ID );
  if ( id ) return id;
  const newID = uuid.v4( ).toString( );
  store.set( INSTALL_ID, newID );
  // Skip setting IS_FRESH_INSTALL in e2e to avoid triggering
  // RNRestart.restart() which kills the Detox instrumentation process
  return newID;
}

export function getEnvironmentOverride( ) {
  return store.getString( ENVIRONMENT_OVERRIDE );
}

export function setEnvironmentOverride( prefix ) {
  if ( prefix ) {
    store.set( ENVIRONMENT_OVERRIDE, prefix );
  } else {
    store.delete( ENVIRONMENT_OVERRIDE );
  }
}

// Subscribers that get notified when a boolean changes, so all components
// using its hook re-render (mimics useMMKVBoolean behavior)
const booleanListeners = new Set();

function useBoolean( key ) {
  const [value, setValue] = useState( () => data.get( key ) ?? false );

  useEffect( () => {
    const listener = () => setValue( data.get( key ) ?? false );
    booleanListeners.add( listener );
    return () => booleanListeners.delete( listener );
  }, [key] );

  const setBoolean = useCallback( newValue => {
    data.set( key, newValue );
    booleanListeners.forEach( l => l() );
  }, [key] );

  return [value, setBoolean];
}

export function useOnboardingShown() {
  return useBoolean( ONBOARDING_SHOWN );
}

export function useOnboardingV2Shown() {
  return useBoolean( ONBOARDING_V2_SHOWN );
}
