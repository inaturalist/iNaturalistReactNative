+// On iOS, a plain MKTileOverlayRenderer intermittently never paints its tiles after
+// the overlay is attached to the map, leaving the tile layer invisible until the user
+// pans or zooms. Rendering through a subclass that overrides the draw path avoids it.
+// Upstream: https://github.com/react-native-maps/react-native-maps/issues/5598
+@interface AIRMapUrlTileRenderer : MKTileOverlayRenderer
+@end
+@implementation AIRMapUrlTileRenderer
+- (BOOL)canDrawMapRect:(MKMapRect)mapRect zoomScale:(MKZoomScale)zoomScale {
+    return [super canDrawMapRect:mapRect zoomScale:zoomScale];
+}
+- (void)drawMapRect:(MKMapRect)mapRect zoomScale:(MKZoomScale)zoomScale inContext:(CGContextRef)context {
+    [super drawMapRect:mapRect zoomScale:zoomScale inContext:context];
+}
+@end
